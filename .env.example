# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed by the Stripe webhook to record donations. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — TEST MODE ONLY. sk_live_ keys are ignored unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# Public URL of the site (used for Stripe redirect URLs and auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
